local OriginalTexts = {}
local TextConnections = {}
local ScanLoopRunning = false

local function ReplaceUsername(instance)
	if not ConfigData.HideUsername then return end
	if not (instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox")) then return end
	local success, currentText = pcall(function() return instance.Text end)
	if not success or type(currentText) ~= "string" then return end
	if not string.find(currentText, player.Name, 1, true) then return end
	if OriginalTexts[instance] == nil then
		OriginalTexts[instance] = currentText
	end
	pcall(function()
		instance.Text = string.gsub(currentText, player.Name, "...")
	end)
end

local function ScanGui(container)
	local success, descendants = pcall(function() return container:GetDescendants() end)
	if not success then return end
	for _, instance in ipairs(descendants) do
		ReplaceUsername(instance)
	end
end

local function EnableUsernameHiding()
	if ScanLoopRunning then return end
	ScanLoopRunning = true
	local PlayerGui = player:WaitForChild("PlayerGui")
	for _, container in ipairs({PlayerGui, CoreGui}) do
		if not TextConnections[container] then
			local success, connection = pcall(function()
				return container.DescendantAdded:Connect(function(instance)
					task.defer(function() ReplaceUsername(instance) end)
				end)
			end)
			if success then TextConnections[container] = connection end
		end
	end
	task.spawn(function()
		while ConfigData.HideUsername and ScanLoopRunning do
			ScanGui(PlayerGui)
			ScanGui(CoreGui)
			task.wait(0.1)
		end
		ScanLoopRunning = false
	end)
end

local function DisableUsernameHiding()
	ScanLoopRunning = false
	for _, conn in pairs(TextConnections) do conn:Disconnect() end
	table.clear(TextConnections)
	for instance, originalText in pairs(OriginalTexts) do
		if instance and instance.Parent then
			pcall(function() instance.Text = originalText end)
		end
	end
	table.clear(OriginalTexts)
end

