	SlapAuraInterval = 0.45,
	SlapAuraFastInterval = 0.1,
	SlapAuraDefaultInterval = 2.2,
	SlapRemote = nil,
}

function Combat.GetSlapRemote()
	local cached = Combat.SlapRemote
	if cached and cached.Parent and cached:IsA("RemoteEvent") then
		return cached
	end
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local remote = remotes and remotes:FindFirstChild("Slap")
	if remote and remote:IsA("RemoteEvent") then
		Combat.SlapRemote = remote
		return remote
	end
	Combat.SlapRemote = nil
	return nil
end

function Combat.StartSlapAura()
	if Combat.SlapAuraThread then
		return
	end
	Combat.SlapAuraThread = task.spawn(function()
		while Combat.SlapAuraEnabled do
			local remote = Combat.GetSlapRemote()
			local localCharacter = player.Character
			local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
			if remote and localRoot then
				for _, targetPlayer in ipairs(Players:GetPlayers()) do
					if targetPlayer ~= player then
						local targetCharacter = targetPlayer.Character
						local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
						local hum = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
						if targetRoot and hum and hum.Health > 0 then
							if (localRoot.Position - targetRoot.Position).Magnitude <= Combat.SlapAuraRange then
								pcall(function()
									remote:FireServer(targetRoot)
								end)
							end
						end
					end
				end
			end
			local interval = ConfigData.FastSlapAura and 0.1 or Combat.SlapAuraInterval
			task.wait(interval)
		end
		Combat.SlapAuraThread = nil
	end)
end

function Combat.SetSlapAura(state)
	Combat.SlapAuraEnabled = state == true
	ConfigData.SlapAura = state == true
	SaveConfig()
	if Combat.SlapAuraEnabled then
		Combat.StartSlapAura()
	end
end

local function GetPlayerInfo(target)
	local targetChar = target.Character
	if not targetChar then return "" end
	local output = {}
	if ConfigData.Glove then
		local glove = target:FindFirstChild("Glove") or (target:FindFirstChild("leaderstats") and target.leaderstats:FindFirstChild("Glove"))
		if glove then
			table.insert(output, "Glove: " .. tostring(glove.Value))
		end
	end
	if ConfigData.Kills then
		local kills = targetChar:GetAttribute("Kills")
		if kills == nil and target:FindFirstChild("leaderstats") and target.leaderstats:FindFirstChild("Kills") then
			kills = target.leaderstats.Kills.Value
		end
		if kills ~= nil then
			table.insert(output, "Kills: " .. tostring(kills))
		end
	end
	if ConfigData.Power then
		local power = targetChar:GetAttribute("Power")
		if power == nil and targetChar:FindFirstChild("Power") then
			power = targetChar.Power.Value
		end
		if power == nil and targetChar:FindFirstChild("leaderstats") and target.leaderstats:FindFirstChild("Power") then
			power = target.leaderstats.Power.Value
		end
		if power ~= nil then
			table.insert(output, "Power: " .. tostring(power))
		end
	end
	if ConfigData.Health then
		local hum = targetChar:FindFirstChildOfClass("Humanoid")
		if hum then
			table.insert(output, "HP: " .. tostring(math.floor(hum.Health + 0.5)) .. "/" .. tostring(math.floor(hum.MaxHealth + 0.5)))
		end
	end
	if ConfigData.Speed then
		local hum = targetChar:FindFirstChildOfClass("Humanoid")
		if hum then
			table.insert(output, "Speed: " .. tostring(math.floor(hum.WalkSpeed + 0.5)))
		end
	end
	if ConfigData.JumpPower then
		local hum = targetChar:FindFirstChildOfClass("Humanoid")
		if hum then
			local jp = hum.JumpPower > 0 and hum.JumpPower or hum.JumpHeight
			table.insert(output, "JumpPower: " .. tostring(math.floor(jp + 0.5)))
		end
	end
	return table.concat(output, "\n")
end

