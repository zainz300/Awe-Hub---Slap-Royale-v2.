local function TP()
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hrp and hum then
		local direction = hum.MoveDirection
		if direction.Magnitude > 0 then
			direction = direction.Unit
			local boxCFrame, boxSize = char:GetBoundingBox()
			local rayParams = RaycastParams.new()
			rayParams.FilterType = Enum.RaycastFilterType.Exclude
			rayParams.FilterDescendantsInstances = {char}
			local result = workspace:Blockcast(boxCFrame, boxSize, direction * speeddistance, rayParams)
			local distance = speeddistance
			if result then
				distance = math.max(result.Distance - 0.5, 0)
			end
			if distance > 0 then
				hrp.CFrame += direction * distance
			end
		end
	end
end

