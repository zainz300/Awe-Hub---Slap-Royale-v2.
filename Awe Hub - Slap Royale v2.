-- RayParams for Safe TP Logic
local RayParams = RaycastParams.new()
RayParams.FilterDescendantsInstances = {character}
RayParams.FilterType = Enum.RaycastFilterType.Exclude

local function PumpkinSafeTP(targetPart)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp or not targetPart then return end
	local targetPos = targetPart.Position
	
	local sideDirs = {
		Vector3.new(3, 0, 0),
		Vector3.new(-3, 0, 0),
		Vector3.new(0, 0, 3),
		Vector3.new(0, 0, -3)
	}
	
	local chosenSide = nil
	for _, dir in ipairs(sideDirs) do
		local ray = workspace:Raycast(targetPos, dir, RayParams)
		if not ray then
			chosenSide = dir
			break
		end
	end
	
	if chosenSide then
		hrp.CFrame = CFrame.new(targetPos + chosenSide, targetPos)
	else
		local rightVector = Camera and Camera.CFrame.RightVector or Vector3.new(1, 0, 0)
		hrp.CFrame = CFrame.new(targetPos + rightVector * 4, targetPos)
	end
end

