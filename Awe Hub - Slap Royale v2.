-- FLY INTEGRATION WITH UP/DOWN (E/Q & UI BUTTONS)
-- ==========================================================
local FlyVectorForce = Instance.new("VectorForce")
FlyVectorForce.Attachment0 = humanoidrootpart:WaitForChild("RootAttachment")
FlyVectorForce.ApplyAtCenterOfMass = true
FlyVectorForce.RelativeTo = Enum.ActuatorRelativeTo.World
FlyVectorForce.Force = Vector3.zero
FlyVectorForce.Parent = humanoidrootpart

local IsMobile = false
xpcall(function()
	local platforms = {Enum.Platform.Android, Enum.Platform.IOS}
	IsMobile = table.find(platforms, UserInputService:GetPlatform()) ~= nil
end, function()
	IsMobile = not UserInputService.KeyboardEnabled
end)

local FlyActive = false
local FlyKeys = {W = false, A = false, S = false, D = false, Q = false, E = false}
local MobileFlyUp = false
local MobileFlyDown = false
local FlySpeed = 32
local FlyMultiplier = 150
local FlyConnection = nil

local function StopFly()
	if not FlyActive then return end
	FlyActive = false
	FlyVectorForce.Force = Vector3.zero
	if FlyConnection then
		FlyConnection:Disconnect()
		FlyConnection = nil
	end
end

local function StartFly(speed)
	if FlyActive then StopFly() end
	FlySpeed = speed or 32
	FlyActive = true
	ConfigData.Fly = true
	SaveConfig()

	FlyConnection = RunService.Heartbeat:Connect(function()
		if not FlyActive then return end
		local char = player.Character
		if char and char:GetAttribute("Ragdolled") == true then
			FlyVectorForce.Force = Vector3.zero
			return
		end
		local camCFrame = Camera.CFrame
		local moveVector = Vector3.zero
		
		if FlyKeys.W then moveVector += Vector3.new(0, 0, -1) end
		if FlyKeys.S then moveVector += Vector3.new(0, 0, 1) end
		if FlyKeys.A then moveVector += Vector3.new(-1, 0, 0) end
		if FlyKeys.D then moveVector += Vector3.new(1, 0, 0) end
		if FlyKeys.Q or MobileFlyDown then moveVector += Vector3.new(0, -1, 0) end
		if FlyKeys.E or MobileFlyUp then moveVector += Vector3.new(0, 1, 0) end

		local lookV = Vector3.new(camCFrame.LookVector.X, 0, camCFrame.LookVector.Z).Unit
		local rightV = Vector3.new(camCFrame.RightVector.X, 0, camCFrame.RightVector.Z).Unit
		local dir = (lookV * -moveVector.Z + rightV * moveVector.X + Vector3.new(0, moveVector.Y, 0))
		if dir.Magnitude > 0 then dir = dir.Unit end

		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		if hrp then
			local targetVel = dir * FlySpeed
			local currentVel = hrp.AssemblyLinearVelocity
			local forceX = (targetVel.X - currentVel.X) * FlyMultiplier
			local forceY = (hrp.AssemblyMass * workspace.Gravity) + ((targetVel.Y - currentVel.Y) * FlyMultiplier)
			local forceZ = (targetVel.Z - currentVel.Z) * FlyMultiplier
			FlyVectorForce.Force = Vector3.new(forceX, forceY, forceZ)
		end
	end)
end

